set-option -g default-shell /bin/zsh
set -g default-terminal "screen-256color"
set -g status-bg black
set -g status-fg white

set -g mode-keys vi
set -g status-keys vi
set -g history-limit 50000
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g escape-time 10
set -g update-environment "DISPLAY WAYLAND_DISPLAY WSL_INTEROP SSH_AUTH_SOCK SSH_CONNECTION XAUTHORITY PATH"
setw -g allow-rename off
setw -g automatic-rename off

bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key z resize-pane -Z
bind-key r source-file ~/.tmux.conf \; display-message "tmux config reloaded"
bind-key c new-window -c "#{pane_current_path}"
bind-key '"' split-window -v -c "#{pane_current_path}"
bind-key % split-window -h -c "#{pane_current_path}"

bind-key -T copy-mode-vi Space send-keys -X begin-selection
bind-key -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "~/.local/lib/defaultenv/tmux-copy.sh"

bind-key -n C-h if-shell -F '#{==:#{pane_current_command},nvim}' 'send-keys C-h' 'select-pane -L'
bind-key -n C-j if-shell -F '#{==:#{pane_current_command},nvim}' 'send-keys C-j' 'select-pane -D'
bind-key -n C-k if-shell -F '#{==:#{pane_current_command},nvim}' 'send-keys C-k' 'select-pane -U'
bind-key -n C-l if-shell -F '#{==:#{pane_current_command},nvim}' 'send-keys C-l' 'select-pane -R'

bind-key g if-shell -F '#{>=:#{version},3.2}' \
  'display-popup -E -w 85% -h 85% -d "#{pane_current_path}" "$HOME/.local/lib/defaultenv/tmux-lazygit.sh"' \
  'new-window -c "#{pane_current_path}" "$HOME/.local/lib/defaultenv/tmux-lazygit.sh"'
